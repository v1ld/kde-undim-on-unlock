#!/bin/bash
# Workaround for KDE bug 513809: PowerDevil sometimes leaves KWin's output
# dimming at 30% after the screen wakes. On every unlock, wait a moment for
# PowerDevil to undim, then force dimming back to 100% if it is still lower.
OUTPUT="${1:-DP-1}"

fix() {
    sleep 3
    if kscreen-doctor -o 2>/dev/null | grep -qE 'dimming to ([0-9]|[1-9][0-9])%'; then
        logger -t undim-on-unlock "dimming stuck on $OUTPUT, resetting to 100%"
        kscreen-doctor "output.$OUTPUT.dimming.100" >/dev/null 2>&1
    fi
}

dbus-monitor --session "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'" |
while read -r line; do
    case "$line" in
        *"boolean false"*) fix & ;;
    esac
done
